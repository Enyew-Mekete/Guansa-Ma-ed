# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Application
PORT=3000

# Authentication
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Bootstrap Users
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-unique-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-another-unique-password

BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=super-admin@example.com
BOOTSTRAP_SUPER_ADMIN_PHONE=0900000000

BOOTSTRAP_ADMIN_NAME=Restaurant Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=0900000001

# SMTP
SMTP_USER=
SMTP_PASS=
