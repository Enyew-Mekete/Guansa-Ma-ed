{
  "name": "guansa-maed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "dev:backend": "tsx watch backend/index.ts",
    "build": "vite --config frontend/vite.config.ts build",
    "preview": "vite --config frontend/vite.config.ts preview --host 0.0.0.0",
    "start": "npm run start:backend",
    "start:backend": "tsx backend/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('frontend/dist',{recursive:true,force:true})\"",
    "lint": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
